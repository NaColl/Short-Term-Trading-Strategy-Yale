# ╔══════════════════════════════════════════════════════════════╗
# ║  APEX Trading System — Environment Variables                ║
# ║  Copy to .env and fill in real values before running.       ║
# ╚══════════════════════════════════════════════════════════════╝

# ── APEX Environment ─────────────────────────────────────────
# Controls broker port, logging level, and safety checks.
# Values: production | paper | backtest
APEX_ENV=paper

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJ...your-service-role-key...
SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Anthropic (LLM Classification) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Polygon.io (Market Data) ────────────────────────────────
POLYGON_API_KEY=your-polygon-api-key

# ── IBKR (Broker) ───────────────────────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_PORT_PAPER=4002
IBKR_CLIENT_ID=1

# ── Firecrawl (Web Scraping for SEDAR+) ─────────────────────
FIRECRAWL_API_KEY=fc-...

# ── SEC EDGAR ────────────────────────────────────────────────
# Required: SEC mandates a descriptive User-Agent string
SEC_USER_AGENT=APEX Trading research@apexcapital.com

# ── EIA (Energy Information Administration) ──────────────────
EIA_API_KEY=your-eia-api-key

# ── Quandl / Nasdaq Data Link ────────────────────────────────
QUANDL_API_KEY=your-quandl-api-key

# ── Slack Alerts ─────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_OPS_CHANNEL=#ops-alerts
SLACK_RISK_CHANNEL=#risk-critical
SLACK_EVENTS_CHANNEL=#event-alerts
SLACK_PNL_CHANNEL=#daily-pnl

# ── n8n Auth ─────────────────────────────────────────────────
N8N_AUTH_USER=apex
N8N_AUTH_PASSWORD=change-me-in-production

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me-in-production

# ── Service URLs (internal Docker network) ───────────────────
CLASSIFICATION_SERVICE_URL=http://detection:8001
FUNDAMENTAL_SERVICE_URL=http://fundamental:8002
SIGNAL_SERVICE_URL=http://signals:8003
RISK_SERVICE_URL=http://risk:8004
EXECUTION_SERVICE_URL=http://execution:8005
